{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "PlatformIO: Upload Filesystem",
            "command": "${userHome}/.platformio/penv/bin/platformio",
            "args": [
                "run",
                "--target",
                "uploadfs"
            ],
            "problemMatcher": [
                "$platformio"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "type": "shell",
            "label": "PlatformIO: Upload Filesystem (env)",
            "command": "${userHome}/.platformio/penv/bin/platformio",
            "args": [
                "run",
                "--target",
                "uploadfs",
                "--environment",
                "esp32-s3-audioboard"
            ],
            "problemMatcher": [
                "$platformio"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
