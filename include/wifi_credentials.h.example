// ---------------------------------------------------------------------------
// WiFi credentials override for IU3QEZ Keyer
// Copy this file to include/wifi_credentials.h, fill in your secrets, and keep
// the real file out of source control (.gitignore handles it).
// ---------------------------------------------------------------------------

// Access Point mode credentials
#define WIFI_AP_SSID        "IU3QEZ-Keyer"
